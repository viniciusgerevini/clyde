{{> header }}
{{> side-navigation }}
<main class="content page-doc with-menu home-page" role="main">

	<div class="clyde-interactive">
<div class="clyde-player">
	<div class="p-avatar">
		<img id="speakerAvatar" src="{{assetImage "avatar_normal.svg"}}" />
	</div>
	<div class="p-content">
		<span id="speaker">Clyde</span>
		<p id="dialogueContent">
			Clyde is a language for writing game dialogues. It supports branching, translations and interfacing with your game through variables and events. Click next to continue.
		</p>
		<ul id="dialogueOptions" styles="display: none;">
		</ul>
		<button id="nextBtn">Next</button>
	</div>
</div>
	{{{ mainContent }}}
	</div>

	<h2>Learn more</h2>

	<div class="home-sections">
		<div class="home-section-link">
				<img src="{{ assetImage "icon_language.svg" }}" />
				<h2>Language reference</h2>
				<p>
					This quick reference covers all language features.
				</p>
			<div class="info-button"><a href="/en/language">Read more</a></div>
		</div>

	<div class="home-section-link">
			<img src="{{ assetImage "icon_godot.svg" }}" />
			<h2>Clyde for Godot</h2>
			<p>
				Everything you need to know to use Clyde with Godot.
			</p>
			<div class="info-button"><a href="/en/godot">Read more</a></div>
	</div>

	<div class="home-section-link">
			<img src="{{ assetImage "icon_tools.svg" }}" />
			<h2>Clyde Tools</h2>
			<p>
				Want to write and run Clyde with your favourite editor? These tools got you covered.
			</p>
			<div class="info-button"><a href="/en/tools">Read more</a></div>
	</div>

	</div>

	<div class="home-extra-content">

		<h2>About</h2>

			<p>❤️ Clyde was created by Vinicius Gerevini <a href="https://thisisvini.com">thisisvini.com</a>.</p>

		<p>🎨 Logo and site design by Fabiane Molon <a href="https://fabianemolon.com">fabianemolon.com</a>.</p>

		<p>📜 The language and its tools are licensed under the <a href="https://github.com/viniciusgerevini/clyde/blob/main/LICENSE">MIT License</a>.</p>

		<p>🐛 To report bugs in the Godot plugin, open an issue on the plugin's <a href="https://github.com/viniciusgerevini/godot-clyde-dialogue">repository</a></p>

		<p>👋 If you are looking for help, general questions, ideas or just want to share something, please use our main <a href="https://github.com/viniciusgerevini/clyde/discussions">discussion forum</a>.</p>

		<p>🎮 I would also love to see what games you've been making with Clyde. If you have any released project using clyde, share it with us <a href="https://github.com/viniciusgerevini/clyde/discussions/3">in this thread</a> or send it to me. You can find my contact on <a href="https://thisisvini.com">my website</a></p>
	</div>
</main>
<script>
	window.onload = () => {
		const content = `
Clyde:
	Clyde is a language for writing game dialogues. It supports branching,
		translations and interfacing with your game through variables and events.
		This bubble is a real interpreter running the dialogue bellow.
	Do you wanna hear more?
		+ Yes
			-> yes branch
		+ No, thanks
			-> no branch

Clyde: Have fun! #happy

== yes branch
Clyde:
	Excellent! There is a lot to talk about, but
		this is a brief example. #happy
	Hopefully, this is enough to grab your attention.
	If you want to know more about the language, check the %language_reference_page%.
	If you are using Godot, the %godot_page% has lots of useful information on how
		to set up and use the integration.
	Now if you rather use your own text editor, or a different programming language, take a look at
			the %tools_page%.
Mr. Pink: Hey, buddy! Time to go!
Clyde: Oops! See you later! #happy


== no branch
Clyde: Oh! OK! I get it! Feel free to explore the site on your own. #sad
`;

	const imageNormalPath = "{{assetImage "avatar_normal.svg"}}";
	const imageHappyPath = "{{assetImage "avatar_happy.svg"}}";
	const imageSadPath = "{{assetImage "avatar_sad.svg"}}";
	const imageMrPinkPath = "{{assetImage "mr_pink.svg"}}";

	const dialogue = ClydeInterpreter.createDialogue(content);

	dialogue.setVariable("language_reference_page", "<a href='/en/language'>language reference page</a>")
	dialogue.setVariable("godot_page", "<a href='/en/godot'>Godot section</a>")
	dialogue.setVariable("tools_page", "<a href='/en/tools'>tools page</a>")

	const speaker = document.getElementById('speaker');
	const speakerAvatar = document.getElementById('speakerAvatar');
	const dialogueContent = document.getElementById('dialogueContent');
	const dialogueOptions = document.getElementById('dialogueOptions');
	const nextBtn = document.getElementById('nextBtn');

	function adjustAvatar(speaker, tags) {
		if (speaker === "Mr. Pink") {
			speakerAvatar.src = imageMrPinkPath;
			return;
		}

		if (tags?.includes("happy")) {
			speakerAvatar.src = imageHappyPath;
			return;
		}

		if (tags?.includes("sad")) {
			speakerAvatar.src = imageSadPath;
			return;
		}

		speakerAvatar.src = imageNormalPath;
	}

	function getNext() {
		const c = dialogue.getContent();

		if (c.type === "line") {
			speaker.innerText = c.speaker;
			dialogueContent.innerHTML = c.text;
			dialogueOptions.style.display = "none";
			nextBtn.style.display = "block";
			adjustAvatar(c.speaker, c.tags);
		} else if (c.type === "options") {
			speaker.innerText = c.speaker;
			dialogueContent.innerText = c.text;
			dialogueOptions.style.display = "block";
			nextBtn.style.display = "none";
			dialogueOptions.innerText = "";

			c.options.forEach((o, i) => {
				const li = document.createElement("li"); 
				const button = document.createElement("button"); 
				button.innerText = o.text;
				button.onclick = () => {
					dialogue.choose(i);
					getNext();
				};

				dialogueOptions.appendChild(li);
				li.appendChild(button);
			});
		} else {
			speaker.innerText = "";
			dialogueOptions.style.display = "none";
			nextBtn.style.display = "none";

			const button = document.createElement("button"); 
			button.innerText = "Restart Dialogue";
			button.onclick = () => {
				dialogue.start();
				getNext();
			};
			dialogueContent.innerText = "";
			dialogueContent.appendChild(button);
		}
	}

	document.getElementById('nextBtn').onclick = () => {
		getNext();
	};
	getNext();
};
</script>
{{> footer }}
